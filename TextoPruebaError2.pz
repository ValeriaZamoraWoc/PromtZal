    // ERROR: identificador iniciado con numero

    variable mi-variable = 25
    // ERROR: identificador con '-'

    variable dato$invalido = 10
    // ERROR: caracter '$'

    variable numero_malo = 12.34.56
    // ERROR: mas de un punto

    variable decimal_malo = .75
    // ERROR: decimal iniciado con punto

    variable decimal_malo2 = 75.
    // ERROR: decimal terminado en punto

    variable caracter_malo = hola?
    // ERROR: caracter '?'

    contexto = "Esta cadena si esta cerrada"

    @directivaInexistente "prueba"
    // ERROR: directiva inexistente

    comandoInexistente datos -> resultado
    // ERROR: lexema desconocido

    variable numeroInvalido = 123abc
    // ERROR: mezcla de numero e identificador

    contexto = "Esta cadena NO esta cerrada...
    // ERROR: cadena sin cerrar
