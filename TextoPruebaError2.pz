@modelo "claude-sonnet-4-6"
@rol "ingeniero de software"
@formato "markdown"

/* =========================================================
   PRUEBA DE FUEGO DEL ANALIZADOR LÉXICO
   ========================================================= */

AGENTE _analista2026 {
    contexto = "Eres un analista experto en datos, código y documentación"

    variable ventas_2026 = CARGAR("ventas.csv")
    variable archivo_datos = CARGAR("datos_01.json")

    // Comandos de IA y conectores
    PREGUNTAR "Cuales son las 3 tendencias principales?" SOBRE ventas_2026 -> tendencias
    GENERAR codigo DESDE "una funcion que procese los datos" + tendencias -> script
    RESUMIR tendencias EN 100 palabras -> resumen
    ANALIZAR ventas_2026 SOBRE "errores y valores atipicos" -> analisis
    TRADUCIR resumen EN "ingles" -> traduccion
    CLASIFICAR ventas_2026 EN "alto, medio, bajo" -> categorias
    EXTRAER datos SOBRE "nombres y cantidades" -> informacion

    variable entero = 100
    variable decimal = 0.75
    variable otro_decimal = 123.456

    contexto = "Cadena con numeros 123 y simbolos + = { } ( ) ,"

    /* -----------------------------------------------------
       Comentario de bloque
       con varias lineas
       y diferentes caracteres: + = -> @
       ----------------------------------------------------- */

    variable _privado = "identificador con guion bajo"
    variable dato123 = "identificador con numeros"
}

EJECUTAR _analista2026
EXPORTAR resumen, script, analisis, traduccion, categorias, informacion


/************************************************************
                     ERRORES INTENCIONALES
 ************************************************************/

